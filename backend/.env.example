# ============================================================================
# ZoomRideXX Car Rentals WhatsApp AI Agent - environment template
# Copy to `backend/.env` and fill real values. NEVER commit the real .env.
# ============================================================================

# --- Kapso (WhatsApp transport) ---------------------------------------------
# Project API key: app.kapso.ai -> Integrations -> API keys
KAPSO_API_KEY=
# WhatsApp Business phone number ID from the Kapso dashboard.
# Use a dedicated number for ZoomRideXX, or stop any other agent sharing it.
KAPSO_PHONE_NUMBER_ID=
# Webhook signing secret (X-Webhook-Signature = hmac-sha256-hex of the raw body).
KAPSO_WEBHOOK_SECRET=

# Public HTTPS URL for push webhook delivery (tunnel / deployment). The built-in
# poller works with the loopback default and needs no public URL.
PUBLIC_BASE_URL=http://localhost:8022

# Keep at 1 in production. If another agent is still running on the same
# WhatsApp number, ZoomRideXX serves the console/API but does not poll or reply
# until that other process is stopped. Set 0 only for an isolated dev number.
SHARED_NUMBER_LOCK=1

# --- LLM failover chain ------------------------------------------------------
# Chain and per-tier models live in backend/app/config.py:
#   cleanapis -> manifest -> apinex -> apiqik -> axqua
# A failing provider is skipped on an error-specific cooldown. At least one
# reliable, funded provider is required for natural-language turns. The free
# providers used during development enforce low request-per-minute limits.
CLEANAPIS_API_KEY=
CLEANAPIS_BASE_URL=https://cleanapis.com/v1
MANIFEST_API_KEY=
MANIFEST_BASE_URL=https://app.manifest.build/v1
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1
APIQIK_API_KEY=
APIQIK_BASE_URL=https://api.apiqik.com/v1
AXQUA_API_KEY=
AXQUA_BASE_URL=https://axqua.com/v1
LLM_TOTAL_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3

# Optional last-resort remote AI proxy. Leave blank for local operation.
AI_PROXY_URL=
AI_PROXY_TOKEN=

# On startup, never replay a checkpoints older than this. WhatsApp free-form
# replies are limited to the 24-hour customer service window anyway.
POLL_MAX_CATCHUP_HOURS=24
# Seconds between inbound polls when no webhook is configured. Lower = faster
# replies, higher = fewer API calls. Default 3.
KAPSO_POLL_SECONDS=3

# --- Server ------------------------------------------------------------------
BACKEND_PORT=8022
# Next.js console dev server (frontend/). 3020 avoids the other local apps.
FRONTEND_ORIGIN=http://localhost:3020
# Protect the owner console APIs when reachable beyond localhost. Set a long
# random value and enable the guard for a public deployment. The browser console
# has no token prompt yet, so expose it only on a trusted network / behind an
# authenticated reverse proxy, or call the API with X-Admin-Token yourself.
ADMIN_API_TOKEN=
ADMIN_AUTH_REQUIRED=0

# Owner console login (/console). The login form checks these and issues the
# admin token. Leave blank to disable the login endpoint. Change these!
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ----------------------------------------------------------------
# Relative SQLite paths resolve under backend/. The filename is retained so
# existing rental data (customers, vehicles, bookings) is preserved.
DATABASE_URL=sqlite:///data/rental_agent.db

# --- Images the agent sends --------------------------------------------------
# Vehicle photos live inside backend/assets/images and are addressed by registry
# id, never by an absolute path. With a loopback media base URL the agent uploads
# bytes to WhatsApp directly; set MEDIA_PUBLIC_BASE_URL to a public host to send
# hosted links instead.
MEDIA_PUBLIC_BASE_URL=
ASSETS_IMAGE_DIR=
MAX_IMAGE_BYTES=8388608
MEDIA_DIRECT_UPLOAD=1

# --- Human handoff -----------------------------------------------------------
# Minutes without a staff reply before the agent takes the chat back (0 = never).
HANDOFF_AUTO_RESUME_MINUTES=30

# --- Owner alerts ------------------------------------------------------------
# Comma/space separated WhatsApp numbers that receive the instant new-booking
# alert (fleet desk). Include the country code, digits only.
OWNER_WHATSAPP_NUMBERS=9179642928,9516108857

# --- Customer website ---------------------------------------------------------
# WhatsApp Business number used by the website's "Book on WhatsApp" deep links
# (digits only, WITH country code). Defaults to 91 + the first fleet-desk
# number above, which is the chat link this project has always published.
WA_BUSINESS_NUMBER=

# --- Rental defaults ---------------------------------------------------------
# Business name, tone, policies and hours are persisted in the persona settings
# table and edited from the console. The values below are pricing defaults.
RENTAL_CURRENCY=₹
RENTAL_DRIVER_FEE_PER_DAY=800
RENTAL_DELIVERY_FEE=500
RENTAL_LICENSE_REQUIRED=1
RENTAL_DEPOSIT_REQUIRED=1
RENTAL_MAX_BOOKING_DAYS=60
RENTAL_MIN_LEAD_HOURS=2
